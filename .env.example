# Required
ANTHROPIC_API_KEY=sk-ant-...

# Local dev defaults (docker-compose values)
DATABASE_URL=postgresql://education:education@localhost:5432/education
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=education-artefacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Auth (M-7+; not required for M-0)
JWT_SECRET=change-me

# Langfuse (M-0 self-hosted; optional - tracing is no-op if blank)
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Model defaults (overridable per-agent)
DEFAULT_MODEL=claude-opus-4-7
JUDGEMENT_MODEL=claude-sonnet-4-6
HIGH_VOLUME_MODEL=claude-haiku-4-5-20251001

# Token budget guard (per-user per-day)
DAILY_TOKEN_BUDGET=20000
